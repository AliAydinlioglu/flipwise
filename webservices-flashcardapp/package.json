{
  "name": "flipwise",
  "version": "1.0.0",
  "description": "Application for the course Web Services.",
  "main": "./out/src/index.js",
  "packageManager": "yarn@4.4.0",
  "scripts": {
    "lint": "eslint .",
    "start": "env-cmd -f .env ts-node src/index.ts --custom-string",
    "startDemon": "env-cmd nodemon ./src/index.ts",
    "test": "env-cmd -f .env.test jest --runInBand",
    "test:coverage": "env-cmd -f .env.test jest --env jsdom --runInBand --coverage",
    "startJS": "env-cmd node ./out/src/index.js --custom-string",
    "serverJS": "node ./out/src/index.js",
    "serverJSReset": "node ./out/src/index.js --custom-string",
    "docs:build": "apidoc -i src -o apidoc",
    "docs:open": "serve apidoc"
  },
  "author": "ALI AYDINLIOGLU",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.1",
    "argon2": "^0.31.2",
    "config": "^3.3.9",
    "env-cmd": "^10.1.0",
    "helmet": "^8.0.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "koa": "^2.14.2",
    "koa-body": "^6.0.1",
    "koa-bodyparser": "^4.4.1",
    "koa-helmet": "^7.0.2",
    "mysql2": "^3.6.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stylistic/eslint-plugin": "^2.12.1",
    "@types/config": "^3.3.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/knex": "^0.15.2",
    "@types/koa": "^3.0.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa__cors": "^4.0.3",
    "@types/koa__router": "^12.0.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/supertest": "^2.0.16",
    "apidoc": "^1.2.0",
    "env-cmd": "^10.1.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^23.0.1",
    "mocha": "11.0.1",
    "nodemon": "^3.0.1",
    "serve": "^14.2.4",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "nodemonConfig": {
    "signal": "SIGTERM",
    "ignore": [
      "node_modules/*",
      ".vscode/*"
    ],
    "delay": "80",
    "watch": [
      "config",
      "src"
    ],
    "quiet": true,
    "ext": "ts,json",
    "legacyWatch": false,
    "exec": "ts-node ./src/index.ts"
  },
  "engines": {
    "npm": ">=9.8.0",
    "node": ">=20.6.0",
    "yarn": ">=1.22.0"
  }
}
